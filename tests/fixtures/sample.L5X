<?xml version="1.0" encoding="UTF-8"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="32.011" TargetName="SampleController" TargetType="1756-L83E">
  <Controller Name="SampleController" LastModifiedDate="Mon Dec 09 14:30:00 2024">
    <Description>Sample PLC project for testing</Description>
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="AOI_Motor">
        <Parameters/>
        <LocalTags/>
        <Routines/>
      </AddOnInstructionDefinition>
      <AddOnInstructionDefinition Name="AOI_Valve">
        <Parameters/>
        <LocalTags/>
        <Routines/>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
    <Tags>
      <Tag Name="System_Running" DataType="BOOL" Value="0">
        <Description>System run status</Description>
      </Tag>
      <Tag Name="Motor_Speed" DataType="DINT" Value="1500">
        <Description>Motor speed setpoint RPM</Description>
      </Tag>
      <Tag Name="Temperature_Array" DataType="REAL" Dimensions="10">
        <Description>Temperature sensor readings</Description>
      </Tag>
    </Tags>
    <Programs>
      <Program Name="MainProgram">
        <Description>Main control program</Description>
        <Tags>
          <Tag Name="Local_Counter" DataType="DINT" Value="0">
            <Description>Local program counter</Description>
          </Tag>
        </Tags>
        <Routines>
          <Routine Name="MainRoutine" Type="RLL">
            <Description>Main ladder routine</Description>
            <RLLContent>
              <Rung Number="0" Type="N">
                <Comment>Start sequence logic</Comment>
                <Text>XIC(Start_Button)OTE(System_Running);</Text>
              </Rung>
              <Rung Number="1" Type="N">
                <Comment>Motor control</Comment>
                <Text>XIC(System_Running)OTE(Motor_Run);</Text>
              </Rung>
              <Rung Number="2" Type="N">
                <Comment>Safety interlock</Comment>
                <Text>XIC(E_Stop)[XIC(Guard_Closed),XIC(Pressure_OK)]OTE(Safe_To_Run);</Text>
              </Rung>
            </RLLContent>
          </Routine>
          <Routine Name="Initialize" Type="ST">
            <Description>Initialization routine</Description>
            <STContent>
              <Line Number="0"><![CDATA[// Initialize system variables]]></Line>
              <Line Number="1"><![CDATA[Motor_Speed := 1500;]]></Line>
              <Line Number="2"><![CDATA[System_Running := FALSE;]]></Line>
              <Line Number="3"><![CDATA[IF First_Scan THEN]]></Line>
              <Line Number="4"><![CDATA[  Init_Complete := TRUE;]]></Line>
              <Line Number="5"><![CDATA[END_IF;]]></Line>
            </STContent>
          </Routine>
        </Routines>
      </Program>
      <Program Name="SafetyProgram">
        <Description>Safety monitoring</Description>
        <Tags/>
        <Routines>
          <Routine Name="SafetyCheck" Type="FBD">
            <Description>Safety function block routine</Description>
            <FBDContent>
              <Sheet Number="0">
                <Block ID="0" Type="AND" X="100" Y="50">
                  <Pin ID="1" Name="In1"/>
                  <Pin ID="2" Name="In2"/>
                  <Pin ID="3" Name="Out"/>
                </Block>
              </Sheet>
              <Sheet Number="1">
                <Block ID="0" Type="OR" X="100" Y="50">
                  <Pin ID="1" Name="In1"/>
                  <Pin ID="2" Name="In2"/>
                  <Pin ID="3" Name="Out"/>
                </Block>
              </Sheet>
            </FBDContent>
          </Routine>
        </Routines>
      </Program>
    </Programs>
    <Tasks>
      <Task Name="MainTask" Type="CONTINUOUS">
        <ScheduledPrograms>
          <ScheduledProgram Name="MainProgram"/>
          <ScheduledProgram Name="SafetyProgram"/>
        </ScheduledPrograms>
      </Task>
    </Tasks>
  </Controller>
</RSLogix5000Content>
